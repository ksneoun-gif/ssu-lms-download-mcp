--- /dev/null
+++ b/test_transcript_package.py
@@ -0,0 +1,67 @@
+"""Offline regressions for incomplete packages and isolated Python startup."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+import bootstrap
+
+ROOT = Path(__file__).resolve().parent
+
+class TranscriptPackageTests(unittest.TestCase):
+    def test_missing_lecture_rejected_before_configuration(self):
+        from install_windows import configuration
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            for name in bootstrap.REQUIRED_FILES:
+                if name != 'lecture.py':
+                    (root / name).touch()
+            with self.assertRaisesRegex(ValueError, 'lecture.py'):
+                configuration(root, sys.executable)
+            self.assertFalse((root / '.mcp.json').exists())
+
+    def test_complete_package(self):
+        bootstrap.validate_package(ROOT)
+        bootstrap.validate_package(ROOT / 'plugins/ssu-lms')
+
+    def test_safe_path_loads_transcription_without_starting_worker(self):
+        # Stub only third-party imports; exercise real server, lecture and runtime files.
+        probe = '''
+import json, runpy, sys, tempfile, types
+from pathlib import Path
+requests = types.ModuleType('requests')
+requests.Session = type('Session', (), {})
+requests.Response = type('Response', (), {})
+requests.RequestException = type('RequestException', (Exception,), {})
+sys.modules['requests'] = requests
+fastmcp = types.ModuleType('mcp.server.fastmcp')
+class FastMCP:
+    def __init__(self, *args): pass
+    def tool(self): return lambda function: function
+fastmcp.FastMCP = FastMCP
+sys.modules['mcp'] = types.ModuleType('mcp')
+sys.modules['mcp.server'] = types.ModuleType('mcp.server')
+sys.modules['mcp.server.fastmcp'] = fastmcp
+server = runpy.run_path(sys.argv[1], run_name='package_test')
+import lecture
+assert Path(lecture.__file__).resolve().parent == Path(sys.argv[1]).resolve().parent
+with tempfile.TemporaryDirectory() as directory:
+    lecture.ROOT = Path(directory)
+    assert server['lecture_transcript']('probe', False) == {'status': 'not_started'}
+    assert not list(Path(directory).iterdir())
+print('TRANSCRIPTION_MODULE_OK')
+'''
+        for root in (ROOT, ROOT / 'plugins/ssu-lms'):
+            with self.subTest(root=root), tempfile.TemporaryDirectory() as cwd:
+                result = subprocess.run([sys.executable, '-I', '-c', probe, str(root/'server.py')],
+                                        cwd=cwd, capture_output=True, text=True, timeout=30)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertIn('TRANSCRIPTION_MODULE_OK', result.stdout)
+
+    def test_changed_runtime_copies_match(self):
+        for name in ('server.py', 'lecture.py', 'bootstrap.py', 'install_windows.py', 'verify_local.py'):
+            self.assertEqual((ROOT/name).read_bytes(), (ROOT/'plugins/ssu-lms'/name).read_bytes(), name)
+
+if __name__ == '__main__':
+    unittest.main()
